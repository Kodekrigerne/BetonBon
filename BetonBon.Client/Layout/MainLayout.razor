@using BetonBon.Client.Auth
@using BetonBon.Client.Services
@using BetonBon.Client.Shared
@using BetonBon.Client.Shared.Icons
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject LocalStorage localStorage

<div class="layout-container">

    @* Header *@
    <div class="header-wrapper">
    <div class="header">
            <img src="/BbLogoUdenNavn.png" class="avatar"/>
            
            <img src="/HolmsgaardsLogo.png" class="header-info"/>
        
        <div class="settings-dropdown-container">
            <button class="icon-btn" @onclick="@ToggleDropdown">
                <CogWheelIcon />
            </button>
            
            @if (IsDropdownVisible)
            {
                <div class="dropdown-overlay" @onclick="() => IsDropdownVisible = false"></div>
                
                <div class="dropdown-menu">
                    <button class="dropdown-item logout-item" @onclick="@Logout">
                        <LogoutIcon/>
                        Log ud
                    </button>
                </div>
            }
        </div>
    </div>
    </div>

    @* Main Content Area *@
    <div class="main-content">
        <div class="content-wrapper">
            @Body
        </div>
    </div>

    @* Bottom Nav *@
    <div class="bottom-nav">
        <a href="/" class="nav-link active">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span class="nav-text">Hjem</span>
        </a>
            
        <a href="/more" class="nav-link inactive">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="19" cy="12" r="1"></circle>
                <circle cx="5" cy="12" r="1"></circle>
            </svg>
            <span class="nav-text">Mere</span>
        </a>
    </div>
</div>


@code{

    public bool IsDropdownVisible = false;

    public void ToggleDropdown()
    {
        IsDropdownVisible = !IsDropdownVisible;
    }

    public async Task Logout()
    {
        await localStorage.RemoveAsync(BetonBonStorage.Token);
        await localStorage.RemoveAsync(BetonBonStorage.RefreshToken);
        await localStorage.RemoveAsync(BetonBonStorage.Timer);

        var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;

        await customAuthStateProvider.UpdateAuthenticationStatus();
    }
}
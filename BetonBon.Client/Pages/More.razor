@page "/more"

<style>
    .more-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        background-color: #f9fafb;
        font-family: sans-serif;
    }

    /* Header */
    .header {
        background-color: white;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #e5e7eb;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
        flex-shrink: 0;
    }

    .header-title {
        font-size: 1.25rem;
        font-weight: bold;
        color: #111827;
        margin: 0;
    }

    /* Content Area */
    .content {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Help Banner */
    .help-banner {
        background-color: #eff6ff;
        border: 2px solid #bfdbfe;
        border-radius: 1rem;
        padding: 1.25rem;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
    }

    .banner-title-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .banner-title-row h2 {
        font-size: 1.25rem;
        font-weight: bold;
        color: #1e3a8a;
        margin: 0;
    }

    .banner-text {
        color: #1e40af;
        font-size: 1rem;
        font-weight: 500;
        margin: 0;
        line-height: 1.5;
    }

    /* Cards */
    .help-cards-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .help-card {
        background-color: white;
        padding: 1.25rem;
        border-radius: 1rem;
        border: 2px solid #f3f4f6;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .card-icon {
        padding: 0.5rem;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-green { background-color: #dcfce7; color: #15803d; }
    .icon-blue { background-color: #dbeafe; color: #1d4ed8; }
    .icon-orange { background-color: #ffedd5; color: #c2410c; }
    .icon-gray { background-color: #f3f4f6; color: #4b5563; }

    .card-header h3 {
        font-weight: bold;
        color: #111827;
        font-size: 1.125rem;
        margin: 0;
    }

    .card-body {
        color: #4b5563;
        font-size: 0.875rem;
        line-height: 1.6;
        margin: 0;
    }

    /* Support Section */
    .support-section {
        margin-top: 0.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
    }

    .support-title {
        font-size: 0.875rem;
        font-weight: bold;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 0.75rem 0;
    }

    .support-btn {
        width: 100%;
        background-color: white;
        padding: 1rem;
        border-radius: 0.75rem;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-align: left;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .support-btn:active {
        background-color: #f9fafb;
    }

    .support-icon-wrapper {
        width: 3rem;
        height: 3rem;
        background-color: #f3f4f6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4b5563;
        flex-shrink: 0;
    }

    .support-text h2 {
        font-size: 1.125rem;
        font-weight: bold;
        color: #111827;
        margin: 0 0 0.1rem 0;
    }

    .support-text p {
        font-size: 0.875rem;
        color: #6b7280;
        margin: 0;
    }
</style>

<div class="more-container">
    @* Header *@
    <div class="header">
        <h1 class="header-title">Mere & Hjælp</h1>
    </div>

    @* Content *@
    <div class="content">
        <div class="help-banner">
            <div class="banner-title-row">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <h2>Brug for hjælp?</h2>
            </div>
            <p class="banner-text">
                Her finder du korte guides til at komme godt i gang med appen.
            </p>
        </div>

        <div class="help-cards-container">
            @* Card 1: Stopur *@
            <div class="help-card">
                <div class="card-header">
                    <div class="card-icon icon-green">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <h3>Brug af stopur</h3>
                </div>
                <p class="card-body">
                    Tryk på <b>"Start tid"</b> på forsiden, når du går i gang med en opgave. Når du er færdig, trykker du <b>"Stop & Gem"</b>. Derefter vil appen guide dig til at vælge det projekt, du har arbejdet på.
                </p>
            </div>

            @* Card 2: Manuel tid *@
            <div class="help-card">
                <div class="card-header">
                    <div class="card-icon icon-blue">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                        </svg>
                    </div>
                    <h3>Manuel tidsregistrering</h3>
                </div>
                <p class="card-body">
                    Har du glemt stopuret? Gå til <b>"Mine Projekter"</b>, vælg dit projekt og tryk <b>"Registrer timer"</b>. Her kan du manuelt vælge dato og indtaste de timer, du har brugt.
                </p>
            </div>

            @* Card 3: Materialer *@
            <div class="help-card">
                <div class="card-header">
                    <div class="card-icon icon-orange">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m7.5 4.27 9 5.15"></path>
                            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                            <path d="m3.3 7 8.7 5 8.7-5"></path>
                            <path d="M12 22V12"></path>
                        </svg>
                    </div>
                    <h3>Registrer materialer</h3>
                </div>
                <p class="card-body">
                    Gå til <b>"Mine Projekter"</b>, vælg dit projekt og tryk <b>"Registrer materialer"</b>. Tryk på knappen for at vælge et materiale fra listen og angiv prisen for dit forbrug.
                </p>
            </div>
        </div>

        @* Support contact info *@
        <div class="support-section">
            <h3 class="support-title">Personlig hjælp</h3>
                <div class="support-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                </div>
                <div class="support-text">
                    <h2>Ring til kontoret</h2>
                    <p>Vi sidder klar til at hjælpe dig</p>
                </div>
        </div>
    </div>
</div>
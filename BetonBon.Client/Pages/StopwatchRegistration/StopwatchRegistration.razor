@page "/stopwatch-registration"
@using BetonBon.Client.Pages.Home
@using System.Text.Json
@using BetonBon.Client.Services
@inject NavigationManager NavigationManager
@inject LocalStorage LocalStorage
@inject IJSRuntime JS

@if (_initialized)
{
    <div class="allocate-page">
        @* Header *@
        <div class="allocate-header">
            <button class="back-btn" @onclick="NavigateBack">
                <span class="back-icon">‹</span>
                <span>Hjem</span>
            </button>
            <h1>Fordel tid</h1>
        </div>

        <div class="allocate-content">
            @* Total time summary *@
            <div class="time-summary">
                <div class="time-summary-label">Samlet tid på stopur</div>
                <div class="time-summary-value">@FormatSessionElapsed()</div>
                <div class="time-summary-status @(RemainingMinutes == 0 && AllAssigned ? "status-complete" : "status-remaining")">
                    @if (RemainingMinutes == 0 && AllAssigned)
                    {
                        <span>✓ Al tid er fordelt</span>
                    }
                    else if (RemainingMinutes == 0)
                    {
                        <span>Vælg projekt og aktivitet for alle linjer</span>
                    }
                    else
                    {
                        <span>Tid tilbage at fordele: @FormatMinutes(RemainingMinutes)</span>
                    }
                </div>
            </div>

            @* Allocation lines *@
            <div class="allocations-section">
                <div class="allocations-intro">
                    <h2>Hvor skal tiden registreres?</h2>
                    <p>
                        Dette er din primære registrering. Du kan tilføje flere
                        projekter/aktiviteter nedenfor, hvis tiden skal fordeles
                        på andet arbejde.
                    </p>
                </div>

                @foreach (var draft in _allocationDrafts)
                {
                    var d = draft;
                    <div class="allocation-card">
                        @if (_allocationDrafts.Count > 1)
                        {
                            <button class="remove-btn" @onclick="() => RemoveAllocation(d.Id)">
                                ✕
                            </button>
                        }

                        <div class="project-selector" @onclick="() => SelectProjectForAllocation(d.Id)">
                            @if (d.ProjectName != null)
                            {
                                <div class="project-selected">
                                    <div class="project-label">
                                        @(d == _allocationDrafts[0]
                                            ? "Primært Projekt & Aktivitet"
                                            : "Projekt & Aktivitet")
                                    </div>
                                    <div class="project-name">@d.ProjectName</div>
                                    <div class="activity-name">@d.ActivityName</div>
                                </div>
                            }
                            else
                            {
                                <div class="project-empty">
                                    <span>+ Tryk for at vælge projekt</span>
                                </div>
                            }
                        </div>

                        <div class="minutes-control">
                            <div class="minutes-value">Tid: @FormatMinutes(d.Minutes)</div>
                            <div class="minutes-buttons">
                                <button class="min-btn"
                                        disabled="@(d.Minutes == 0)"
                                        @onclick="() => UpdateMinutes(d.Id, -60)">
                                    -60
                                </button>
                                <button class="min-btn"
                                        disabled="@(d.Minutes == 0)"
                                        @onclick="() => UpdateMinutes(d.Id, -15)">
                                    -15
                                </button>
                                <button class="min-btn"
                                        disabled="@(d.Minutes == 0)"
                                        @onclick="() => UpdateMinutes(d.Id, -1)">
                                    -1
                                </button>
                                <div class="minutes-spacer"></div>
                                <button class="min-btn-add"
                                        disabled="@(RemainingMinutes == 0)"
                                        @onclick="() => UpdateMinutes(d.Id, 1)">
                                    +1
                                </button>
                                <button class="min-btn-add"
                                        disabled="@(RemainingMinutes == 0)"
                                        @onclick="() => UpdateMinutes(d.Id, 15)">
                                    +15
                                </button>
                                <button class="min-btn-add"
                                        disabled="@(RemainingMinutes == 0)"
                                        @onclick="() => UpdateMinutes(d.Id, 60)">
                                    +60
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <button class="add-project-btn" @onclick="AddAllocation">
                + Tilføj et projekt mere
            </button>
        </div>

        @* Sticky save button *@
        <div class="save-bar">
            <button class="save-btn" @onclick="SaveAllocations">
                ✓ Gem registreringer
            </button>
        </div>
    </div>
}

@code {
    private bool _initialized;
    private StopwatchSession _session = null!;
    private List<AllocationDraft> _allocationDrafts = [];
    private int _totalMinutes;

    private int TotalAllocated => _allocationDrafts.Sum(d => d.Minutes);
    private int RemainingMinutes => _totalMinutes - TotalAllocated;
    private bool AllAssigned => _allocationDrafts.All(d => d.ProjectId != null && d.ActivityId != null);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var json = await LocalStorage.LoadAsync("bb_timer");
            if (json == null)
                throw new InvalidOperationException("Invalid state: Navigated to stopwatch-registration with no session recorded.");

            _session = JsonSerializer.Deserialize<StopwatchSession>(json)
                ?? throw new InvalidOperationException("Invalid stopwatch session data.");

            _totalMinutes = Math.Max(1, (int)Math.Round(_session.GetOffset().TotalMinutes));

            _allocationDrafts.Add(new AllocationDraft
            {
                Id = Guid.NewGuid(),
                Minutes = _totalMinutes
            });

            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task NavigateBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private void SelectProjectForAllocation(Guid draftId) { }

    private void RemoveAllocation(Guid id)
    {
        _allocationDrafts.RemoveAll(d => d.Id == id);
    }

    private void UpdateMinutes(Guid id, int delta)
    {
        var draft = _allocationDrafts.FirstOrDefault(d => d.Id == id);
        if (draft == null) return;

        var maxAddable = RemainingMinutes;
        var actualDelta = delta;

        if (delta > 0 && delta > maxAddable)
            actualDelta = maxAddable;

        if (draft.Minutes + actualDelta < 0)
            actualDelta = -draft.Minutes;

        draft.Minutes += actualDelta;
    }

    private void AddAllocation()
    {
        if (RemainingMinutes == 0) return;

        var newId = Guid.NewGuid();
        _allocationDrafts.Add(new AllocationDraft { Id = newId });
        SelectProjectForAllocation(newId);
    }

    private void SaveAllocations() { }

    private string FormatSessionElapsed()
    {
        var ts = _session.GetOffset();
        if (ts.TotalHours >= 1)
            return $"{(int)ts.TotalHours}t {ts.Minutes}m {ts.Seconds}s";
        if (ts.TotalMinutes >= 1)
            return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }

    private static string FormatMinutes(int totalMinutes)
    {
        if (totalMinutes == 0) return "0 min";
        var h = totalMinutes / 60;
        var m = totalMinutes % 60;
        if (h > 0) return $"{h}t {m}m";
        return $"{m} min";
    }

    private class AllocationDraft
    {
        public Guid Id { get; set; }
        public int? ProjectId { get; set; }
        public string? ProjectName { get; set; }
        public int? ActivityId { get; set; }
        public string? ActivityName { get; set; }
        public int Minutes { get; set; }
    }
}


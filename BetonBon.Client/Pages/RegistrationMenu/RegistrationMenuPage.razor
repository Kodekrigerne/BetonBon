@using BetonBon.Client.Pages.RegistrationMenu.Activities
@using BetonBon.Client.Pages.RegistrationMenu.Projects
@using BetonBon.Client.Shared.Components.Headers
@using BetonBon.Shared.Models
@using BetonBon.Shared.Models.Activities
@inject RegistrationState State

@page "/registration"
@inject NavigationManager Navigation

<AllProjectsView IsVisible="ProjectsIsVisible"
                 OnClose="OnCloseProjects"
                 OnProjectSelected="SelectProject"/>

<AllActivitiesView IsVisible="ActivitiesIsVisible"
                   OnClose="ReturnToProjects"
                   SelectedProject="State.SelectedProject"
                   OnActivitySelected="SelectActivity"/>

@code {

    private bool ProjectsIsVisible = true;
    private bool ActivitiesIsVisible = false;

    protected override async Task OnInitializedAsync()
    {
        if (State.SelectedProject != null)
        {
            ProjectsIsVisible = false;
            ActivitiesIsVisible = true;
        }
        else 
        {
            State.ClearState();
            ProjectsIsVisible = true;
            ActivitiesIsVisible = false;
        }
    }

    private void SelectProject(ProjectDTO project)
    {
        State.SelectedProject = project;
        ActivitiesIsVisible = true;
        ProjectsIsVisible = false;
    }

    private void SelectActivity(ActivityDTO activity)
    {
        State.SelectedActivity = activity;
        Navigation.NavigateTo("/registration/menu");
    }

    private void ReturnToProjects()
    {
        State.ClearState();
        ProjectsIsVisible = true;
        ActivitiesIsVisible = false;
    }

    private void OnCloseProjects()
    {
        Navigation.NavigateTo("/");
        State.ClearState();
    }
}

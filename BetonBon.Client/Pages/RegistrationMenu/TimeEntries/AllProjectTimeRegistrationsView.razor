@using BetonBon.Client.RefitInterfaces
@using BetonBon.Client.Services
@using BetonBon.Client.Shared.Components
@using BetonBon.Shared.Models
@using BetonBon.Shared.Models.Activities
@using BetonBon.Shared.Models.TimeEntries

@inject IEconomicRelayApi _economicApi
@inject PopupService _popUp

<FullScreenModal IsVisible="IsVisible" OnClose="OnClose" SelectedAnimationStyle="FullScreenModal.ModalAnimationStyles.RightToLeft" Title="Tidsregistreringer" ZIndex="300">

    @* Content *@
    <div class="content">

        <div class="context-banner">
            <div class="context-label">Aktivitet</div>
            <div class="context-value">@Project.Name - @Activity.Name</div>
        </div>

        @if (Registrations == null || !Registrations.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <h3 style="font-weight:bold; color:#374151; margin-bottom:0.5rem;">Ingen tidsregistreringer</h3>
                <p style="font-size:0.875rem;">Der er endnu ikke registreret timer på denne aktivitet.</p>
            </div>
        }
        else
        {
            @foreach (var reg in Registrations.OrderByDescending(r => r.Date))
            {
                <div class="reg-card">
                    <div class="reg-header">
                        <div class="reg-date">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            @reg.Date.ToString("dd. MMMM yyyy", new System.Globalization.CultureInfo("da-DK"))
                        </div>
                        @if (reg.IsApproved)
                        {
                        <button @onclick="() => DeleteRegistration(reg)" class="delete-btn" aria-label="Slet registrering">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                        }
                        else {
                            <div class="tick-icon" aria-label="Registrering er godkendt.">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="tick-icon"><path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z" /></svg>
                            </div>
                        }
                    </div>
                    <div class="reg-body">
                        <div class="time-amount">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                           @FormatHours(reg.NumberOfHours)
                        </div>
                        <div class="time-info">
                            @if (!string.IsNullOrEmpty(reg.Text))
                            {
                                <p class="time-note">"@reg.Text"</p>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</FullScreenModal>

@code {

	[Parameter, EditorRequired]
	public ActivityDTO Activity { get; set; }
	[Parameter, EditorRequired]
	public ProjectDTO Project { get; set; }

	[Parameter, EditorRequired]
	public bool IsVisible { get; set; }

	[Parameter, EditorRequired]
	public EventCallback OnClose { get; set; }

	private List<TimeEntry> Registrations = [];

	protected async override Task OnParametersSetAsync()
	{
		if (IsVisible == true && Activity != null && Project != null)
		{
			try
			{
				var result = await _economicApi.GetTimeEntriesAsync(Project.Number, Activity.Number, 1);
				Registrations = result;

				//TODO: Hent EmployeeNumber
			}
			catch (Exception ex)
			{
				await _popUp.AlertAsync($"Der var et problem med at hente tidsregistreringer. Prøv at lukke af og på igen.\n\nFejlbesked: {ex.Message}");
			}
		}
	}
	private void DeleteRegistration(TimeEntry reg)
	{

	}

	private string FormatHours(double hours)
	{
        return $"{(int)hours} timer {Math.Round((hours % 1) * 60)} min";
	}
}
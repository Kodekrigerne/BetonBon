@using BetonBon.Client.Pages.RegistrationMenu.Activities
@using BetonBon.Client.Pages.RegistrationMenu.Projects
@using BetonBon.Client.Pages.RegistrationMenu.RegisterMaterial
@using BetonBon.Client.Shared.Components
@using BetonBon.Client.Shared.Icons
@using BetonBon.Shared.Models

@page "/registration"
@inject NavigationManager Navigation


<AllProjectsView IsVisible="ProjectsIsVisible" OnCloseProjects="OnCloseProjects" SelectProject="SelectProject"/>
<AllActivitiesView IsVisible="ActivitiesIsVisible" OnClose="ReturnToProjects" SelectedProject="SelectedProject" ActivitySelected="OpenRegistrationMenu"/>

<PickActionPage SelectedProject="SelectedProject" SelectedActivity="SelectedActivity"OnClose="ClosePickActionMenu" IsVisible="RegistrationMenuIsVisible"
    OnViewMaterialHistory="OpenMaterialRegistrationHistory" OnViewTimeHistory="OpenTimeRegistrationHistory" OnOpenTimeRegistration="OpenTimeRegistration"
    OnOpenMaterialRegistration="OpenMaterialRegistration"/>

<RegisterMaterialPage Activity="SelectedActivity" Project="SelectedProject" OnClosed="CloseMaterialRegistration" ShowMaterialModal="MaterialRegistrationIsVisible"></RegisterMaterialPage>



@code {

    private ProjectDTO? SelectedProject;

    private ActivityDTO? SelectedActivity;

    private bool MaterialRegistrationIsVisible;

    private bool ProjectsIsVisible = true;
    private bool ActivitiesIsVisible = false;
    private bool RegistrationMenuIsVisible = false;

    private void SelectProject(ProjectDTO project)
    {
        SelectedProject = project;
        ActivitiesIsVisible = true;
    }

    private void ReturnToProjects()
    {
        ActivitiesIsVisible = false;
    }

    private void OnCloseProjects()
    {
        Navigation.NavigateTo("/");
    }

    private void ViewHistory()
    {

    }

    private void OpenRegistrationMenu(ActivityDTO activity)
    {
        SelectedActivity = activity;
        // ActivitiesIsVisible = false;
        // ProjectsIsVisible = false;
        RegistrationMenuIsVisible = true;
        StateHasChanged();
    }

    private void ClosePickActionMenu()
    {
        RegistrationMenuIsVisible = false;
        // ActivitiesIsVisible = true;
        // ProjectsIsVisible = true;
        SelectedActivity = null;
    }

    private void OpenTimeRegistrationHistory()
    {
        // TODO: Create Time Registration Module
    }

    private void OpenMaterialRegistrationHistory()
    {

    }

    private void OpenTimeRegistration()
    {

    }

    private void OpenMaterialRegistration()
    {
        MaterialRegistrationIsVisible = true;
    }

    private void CloseMaterialRegistration()
    {
        MaterialRegistrationIsVisible = false;
    }

}


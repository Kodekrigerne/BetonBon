@using BetonBon.Client.Shared.Components
@using BetonBon.Client.Shared.Icons
@using BetonBon.Shared.Models

@page "/action-menu"
@inject NavigationManager Navigation

<style>
    .action-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        background-color: #f9fafb;
        font-family: sans-serif;
    }

    /* Header */
    .header {
        background-color: white;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        border-bottom: 1px solid #e5e7eb;
        box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05);
        flex-shrink: 0;
    }

    .back-btn {
        padding: 0.4rem;
        margin-left: -0.4rem;
        color: #2563eb;
        background-color: #eff6ff;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        border: none;
        cursor: pointer;
    }

    .header-title {
        flex: 1;
        text-align: center;
        font-weight: bold;
        font-size: 1.1rem;
        padding-right: 4rem;
        margin: 0;
        color: #111827;
    }

    /* Content Area */
    .content {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Context Card (Selected Project/Activity) */
    .context-card {
        background-color: #eff6ff;
        padding: 1rem;
        border-radius: 0.75rem;
        border: 1px solid #bfdbfe;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    .context-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .context-icon {
        margin-top: 0.2rem;
        color: #2563eb;
        background-color: white;
        padding: 0.4rem;
        border-radius: 0.5rem;
        display: flex;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    .context-label {
        font-size: 0.7rem;
        font-weight: 800;
        color: #1e40af;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.1rem;
    }

    .context-value {
        font-weight: bold;
        font-size: 0.95rem;
        color: #111827;
        line-height: 1.2;
    }

    .divider {
        height: 1px;
        background-color: #dbeafe;
        margin: 0.75rem 0;
    }

    /* Section Labels */
    .section-label {
        font-size: 0.75rem;
        font-weight: 800;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
        padding-left: 0.25rem;
    }

    /* Action Buttons */
    .action-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .action-btn {
        width: 100%;
        background-color: white;
        padding: 1.25rem;
        border-radius: 1rem;
        border: 2px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 1rem;
        text-align: left;
        cursor: pointer;
        transition: transform 0.1s, border-color 0.2s;
    }

    .action-btn:active {
        transform: scale(0.98);
        border-color: #3b82f6;
        background-color: #f9fafb;
    }

    .icon-circle {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .bg-green { background-color: #dcfce7; color: #15803d; }
    .bg-orange { background-color: #ffedd5; color: #c2410c; }
    .bg-grey { background-color: #f3f4f6; color: #4b5563; }

    .action-text h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: bold;
        color: #111827;
    }

    .action-text p {
        margin: 0.1rem 0 0 0;
        font-size: 0.875rem;
        color: #6b7280;
    }

    /* History / List Buttons */
    .history-item {
        background-color: white;
        padding: 1rem;
        border-radius: 0.75rem;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        margin-bottom: 0.5rem;
    }

    .history-item:active {
        background-color: #f3f4f6;
    }

    .history-text {
        flex: 1;
        font-weight: bold;
        font-size: 0.95rem;
        color: #374151;
    }

    .count-badge {
        background-color: #1f2937;
        color: white;
        font-weight: bold;
        font-size: 0.875rem;
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
    }
</style>

<FullScreenModal IsVisible="IsVisible" OnClose="CloseModal" Title="Hvad vil du?">

<div class="action-container">

    @* Content *@
    <div class="content">
        
        @* Context Card *@
        <div class="context-card">
            <div class="context-row">
                <div class="context-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                </div>
                <div>
                    <div class="context-label">Valgt projekt</div>
                    <div class="context-value">@SelectedProject.Name</div>
                </div>
            </div>
            <div class="divider"></div>
            <div class="context-row">
                <div class="context-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 12h7"/><path d="M11 16h7"/><path d="M11 8h7"/><path d="M3 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M3 15a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M3 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
                </div>
                <div>
                    <div class="context-label">Valgt aktivitet</div>
                    <div class="context-value">@SelectedActivity.Name</div>
                </div>
            </div>
        </div>

        <div>
            <div class="section-label">Opret ny registrering</div>
            <div class="action-list">
                <button @onclick="() => NavigateTo()" class="action-btn">
                    <ClockIcon/>
                    <div class="action-text">
                        <h2>Registrer timer</h2>
                        <p>Tilføj arbejdstid for i dag</p>
                    </div>
                </button>

                <button @onclick="() => NavigateTo()" class="action-btn">
                   <MaterialIcon/>
                    <div class="action-text">
                        <h2>Registrer materialer</h2>
                        <p>Tilføj forbrug af materialer</p>
                    </div>
                </button>
            </div>
        </div>

        @* History Section *@
        <div style="margin-top: 0.5rem;">
            <div class="section-label">Historik for denne aktivitet</div>
            
            <div @onclick="() => ViewHistory()" class="history-item">
                <HistoryActivityIcon/>
                <div class="history-text">Se tidsregistreringer</div>
            </div>

            <div @onclick="() => ViewHistory()" class="history-item">
                <HistoryActivityIcon/>
                <div class="history-text">Se materialeregistreringer</div>
            </div>
        </div>

    </div>
</div>

    @code {

    [Parameter, EditorRequired]
    public ProjectDTO SelectedProject { get; set; }

    [Parameter, EditorRequired]
    public ActivityDTO SelectedActivity { get; set; }

    private void NavigateTo()
    {
    }

    private void ViewHistory()
    {
    }

    
	[Parameter, EditorRequired]
	public bool IsVisible { get; set; } = false;

	[Parameter, EditorRequired]
	public EventCallback OnClose { get; set; }

	private async Task CloseModal()
	{
		await OnClose.InvokeAsync();
	}
}




</FullScreenModal>


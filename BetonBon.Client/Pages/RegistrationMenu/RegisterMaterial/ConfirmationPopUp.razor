@using BetonBon.Shared.Models

@if (IsVisible ==true)
{

    <style>
        .confirm-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(17,24,39, 0.6);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: fadeInOverlay 0.2s ease-out;
        }

        .confirm-box {
            background-color: white;
            width: 100%;
            max-width: 400px;
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            animation: slideUpBox 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes fadeInOverlay {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes slideUpBox {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .confirm-header {
            background-color: #f9fafb;
            padding: 1.5rem;
            text-align: center;
            border-bottom: 1px solid #e5e7eb;
        }

        .confirm-icon {
            width: 3.5rem;
            height: 3.5rem;
            background-color: #dbeafe;
            color: #2563eb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem auto;
        }

        .confirm-title {
            margin: 0;
            font-size: 1.25rem;
            font-weight: bold;
            color: #111827;
        }

        .confirm-subtitle {
            margin: 0.25rem 0 0 0;
            font-size: 0.875rem;
            color: #6b7280;
        }

        .confirm-details {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid #f3f4f6;
        }

            .detail-row:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .detail-label {
            font-size: 0.9rem;
            color: #6b7280;
            font-weight: bold;
            flex: 1;
        }

        .detail-value {
            font-size: 1rem;
            color: #111827;
            font-weight: bold;
            text-align: right;
            flex: 1.5;
            word-break: break-word;
        }

            .detail-value.highlight {
                color: #2563eb;
                font-size: 1.125rem;
                font-weight: 900;
            }

        .confirm-actions {
            padding: 1.5rem;
            padding-top: 0;
            display: flex;
            gap: 0.75rem;
        }

        .btn-confirm-action {
            flex: 1;
            padding: 1rem;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;
        }

            .btn-confirm-action:active {
                transform: scale(0.98);
            }

        .btn-cancel {
            background-color: #f3f4f6;
            color: #374151;
        }

            .btn-cancel:active {
                background-color: #e5e7eb;
            }

        .btn-approve {
            background-color: #2563eb;
            color: white;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

            .btn-approve:active {
                background-color: #1d4ed8;
            }
    </style>

    <div class="confirm-overlay" @onclick="HandleCancel">
        <div class="confirm-box" @onclick:stopPropagation="true">

            <div class="confirm-header">
                <div class="confirm-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <h2 class="confirm-title">Bekræft registrering</h2>
                <p class="confirm-subtitle">Er du sikker på, at du vil gemme følgende?</p>
            </div>

            <div class="confirm-details">
                <div class="detail-row">
                    <span class="detail-label">Projekt</span>
                    <span class="detail-value">@Project.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Materiale</span>
                    <span class="detail-value">@Material.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Dato</span>
                    <span class="detail-value">@RegistrationDate.ToString("dd. MMM yyyy")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Note) && Note.Length > 1)
                {
                    <div class="detail-row">
                        <span class="detail-label">Note</span>
                        <span class="detail-value" style="font-weight: normal; color: #4b5563;"> @Note </span>
                    </div>
                }
                
                <div class="detail-row" style="border-bottom: none; padding-top: 0.5rem;">
                    <span class="detail-label" style="align-self: center; font-size: 1rem;">Samlet pris</span>
                    <span class="detail-value highlight">@Amount kr.</span>
                </div>
            </div>

            <div class="confirm-actions">
                <button class="btn-confirm-action btn-cancel" @onclick="HandleCancel">Annuller</button>
                <button class="btn-confirm-action btn-approve" @onclick="HandleConfirm">Godkend og Gem</button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public bool IsVisible { get; set; }

    [Parameter, EditorRequired]
    public ProjectDTO Project { get; set; }

    [Parameter, EditorRequired]
    public MaterialDTO Material { get; set; }

    [Parameter, EditorRequired]
    public double Amount { get; set; }

    [Parameter, EditorRequired]
    public DateTime RegistrationDate { get; set; }

    [Parameter, EditorRequired]
    public string Note { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task HandleConfirm()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

}

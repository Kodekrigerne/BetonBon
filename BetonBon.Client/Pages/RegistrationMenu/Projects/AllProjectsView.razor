@using BetonBon.Client.RefitInterfaces
@using BetonBon.Client.Services
@using BetonBon.Client.Shared.Components
@inject IEconomicRelayApi _economicApi
@inject PopupService _popUpService

<FullScreenModal IsVisible="IsVisible" OnClose="CloseProjects" Title="Vælg Projekt">

    <div class="projects-container">

        
        <SearchComponent @bind-SearchTerm="@Search" @bind-SearchTerm:after="OnSearch"/>


        <div class="project-list">
            @foreach (var project in _filteredProjects)
            {
                <ProjectCard ProjectSelected="@ClickProject" Project="@project"></ProjectCard>
            }
        </div>
    </div>

</FullScreenModal>

@page "/users"

@using BetonBon.Client.Pages.Home
@using BetonBon.Client.RefitInterfaces
@using BetonBon.Client.Shared.Components

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject IBetonBonAPI _api

<div class="users-page-container">
    <div class="users-header">
        <h1>@(isCreating ? "Ny bruger" : "Medarbejdere")</h1>
        @if (!isCreating)
        {
            <button class="create-btn" @onclick="HandleCreateUser">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 20px; height: 20px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Opret Bruger</span>
            </button>
        }
    </div>

    @if (isCreating)
    {
        <div class="form-container">
            <CreateUserForm OnCancel="() => isCreating = false" OnUserCreated="HandleUserCreated" />
        </div>
    }
    else
    {
        <div class="content">
            <div class="user-list">
                @if (users == null)
                {
                    <div class="loader">Henter brugere...</div>
                }
                else
                {
                    @foreach (var user in users)
                    {
                        <SingleUserCard User="@user" OnEditRequested="EditUser" />
                    }
                }
            </div>
        </div>
    }
</div>

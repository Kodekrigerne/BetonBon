@using BetonBon.Client.Services
@using BetonBon.Client.Shared.ViewModels
@using BetonBon.Shared.Models
@using BetonBon.Shared.Models.TimeEntries
@using BetonBon.Shared.Enums
@using BetonBon.Client.RefitInterfaces
@inject IBetonBonApi Api
@inject IEconomicRelayApi EconomicApi
@inject PopupService PopupService

<div class="form-container">

    <div class="form-header">

        <h2>Opret ny bruger</h2>

    </div>

    <EditForm EditContext="@editContext" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="form-group">

            <label>Medarbejder (e-conomic)</label>
            <InputSelect Value="createUserModel.EmployeeNumber"
                         ValueChanged="(int v) => OnEmployeeChanged(v)"
                         ValueExpression="() => createUserModel.EmployeeNumber"
                         class="form-input">
                <option value="0">Vælg medarbejder...</option>
                @foreach (var employee in _employees)
                {
                    <option value="@employee.Number">@employee.Number - @employee.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => createUserModel.EmployeeNumber)" class="validation-error" />
        
        </div>

        <div class="form-group">

            <label>Brugernavn</label>
            <InputText @bind-Value="createUserModel.Username" class="form-input" placeholder="Indtast navn..." />
            <ValidationMessage For="@(() => createUserModel.Username)" class="validation-error" />

        </div>

        <div class="form-group">

            <label>Adgangskode</label>
            <InputText type="password" @bind-Value="createUserModel.Password" class="form-input" />
            <ValidationMessage For="@(() => createUserModel.Password)" class="validation-error" />

        </div>

        <div class="form-group">

            <label>Rolle</label>
            <InputSelect @bind-Value="createUserModel.Role" class="form-input">

                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <option value="@role">@role.ToString()</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => createUserModel.Role)" class="validation-error" />
        </div>

        <div class="form-actions">

            <button type="submit" class="btn-primary" disabled="@(!formIsValid || isSubmitting)">

                @if (isSubmitting)
                {
                    <span>Opretter...</span>
                }
                else
                {
                    <span>Gem Medarbejder</span>
                }

            </button>

            <button type="button" class="btn-secondary" @onclick="OnCancel">Annuller</button>


        </div>
    </EditForm>
</div>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnUserCreated { get; set; }

    private CreateNewUserModel createUserModel = new();
    private List<Employee> _employees = new();

    private EditContext? editContext;
    private bool isSubmitting = false;
    private bool formIsValid = false;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(createUserModel);
        editContext.OnFieldChanged += HandleFieldChanged;

        var result = await EconomicApi.GetEmployeesAsync();
        _employees = result.Items?.ToList() ?? new();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        formIsValid = editContext?.Validate() ?? false;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        bool confirmed = await PopupService.ConfirmAsync(
        $"Er du sikker på, at du vil oprette brugeren {createUserModel.Username}?");

        if (!confirmed) return;

        isSubmitting = true;
        try
        {
            var newUser = new CreateUserDTO(createUserModel.Username, createUserModel.Password, createUserModel.Role, createUserModel.EmployeeNumber);

            await Api.CreateUser(newUser);

            await OnUserCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            //Snackbar ?
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OnEmployeeChanged(int employeeNumber)
    {
        createUserModel.EmployeeNumber = employeeNumber;

        if (string.IsNullOrWhiteSpace(createUserModel.Username))
        {
            createUserModel.Username = _employees
                .FirstOrDefault(e => e.Number == employeeNumber)?.Name ?? "";
        }
    }

    public void Dispose()
    {
        if (editContext != null)
            editContext.OnFieldChanged -= HandleFieldChanged;
    }
}

@using BetonBon.Client.Services
@using BetonBon.Client.Shared.UserModels
@using BetonBon.Shared.Models
@using BetonBon.Shared.Enums
@using BetonBon.Client.RefitInterfaces
@using System.Security.Claims
@using BetonBon.Shared.Models.UserModels
@using Microsoft.AspNetCore.Components.Authorization
@inject IBetonBonApi Api
@inject PopupService PopupService
@inject AuthenticationStateProvider AuthStateProvider

<div class="form-container">

    <div class="form-header">
        <h2>Rediger @originalUsername</h2>
    </div>

    <EditForm EditContext="@editContext" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="form-group">

            <label>Brugernavn</label>
            <InputText @bind-Value="User.Username" class="form-input" />
            <ValidationMessage For="@(() => User.Username)" class="validation-error" />

        </div>

        <div class="form-group">

            <label>Nyt Password (valgfrit)</label>
            <InputText type="password" @bind-Value="User.NewPassword" class="form-input" />
            <ValidationMessage For="@(() => User.NewPassword)" class="validation-error" />

        </div>

        <div class="form-group">

            <label>Rolle</label>
            <InputSelect @bind-Value="User.Role" class="form-input" disabled="@isEditingSelf">
                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <option value="@role">@role.ToString()</option>
                }
            </InputSelect>

        </div>

        <div class="form-actions">

            <button type="submit" class="btn-primary" disabled="@(!formIsValid || isSubmitting)">
                @(isSubmitting ? "Gemmer..." : "Gem ændringer")
            </button>

            <button type="button" class="btn-secondary" @onclick="OnCancel">Annuller</button>

        </div>

        <div class="danger-zone">
            @if (isEditingSelf)
            {
                <p class="info-text danger">Du kan ikke slette din egen administratorkonto.</p>
            }
            <button type="button"
                    class="btn-delete"
                    @onclick="OnDelete"
                    disabled="@isEditingSelf">
                Slet Medarbejder
            </button>
        </div>

    </EditForm>

</div>

@code {
    [Parameter] public UpdateUserModel User { get; set; } = null!;

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnUserUpdated { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private EditContext? editContext;

    private string originalUsername = string.Empty;

    private bool isSubmitting = false;
    private bool formIsValid = true;
    private bool isEditingSelf = false;

    protected override async Task OnInitializedAsync()
    {
        if (User == null) return;

        originalUsername = User.Username;

        editContext = new EditContext(User);
        editContext.OnFieldChanged += HandleFieldChanged;

        await CheckIfEditingSelf();
    }

    private async Task HandleSubmit()
    {
        bool confirmed = await PopupService.ConfirmAsync(
        $"Er du sikker på, at du vil gemme ændringerne for {originalUsername}?");

        if (!confirmed) return;

        isSubmitting = true;
        try
        {
            var dto = new UpdateUserRequest(User.Id, User.Username, User.NewPassword, User.Role);

            await Api.UpdateUser(dto);

            await OnUserUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error updating user: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext != null)
        {
            formIsValid = editContext.Validate();
            
            StateHasChanged();
        }
    }

    private async Task CheckIfEditingSelf()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier) ?? user.FindFirst("sub");

        if (userIdClaim != null)
        {
            isEditingSelf = string.Equals(userIdClaim.Value, User.Id.ToString(), StringComparison.OrdinalIgnoreCase);
        }

    }

}
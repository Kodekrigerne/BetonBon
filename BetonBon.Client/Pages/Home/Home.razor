@page "/"

@using BetonBon.Client.Pages.Administration
@using BetonBon.Client.Services
@using BetonBon.Client.Shared.Components.Headers
@using BetonBon.Client.Shared.Icons
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager _navigation

<HomeHeader />

<div class="home-container">
    

    @* Content *@
    <div class="content">
        <div class="welcome">
            <h2>Velkommen tilbage</h2>
            <p>Hvad vil du registrere i dag?</p>
        </div>

        <ProjectsCard OpenProjects="OpenRegistrations" />

        <TimerCard />

        <AuthorizeView Roles="Admin">

            <Authorized>
                <AdminCard OpenAdmin="NavigateToAdministration" />
            </Authorized>

        </AuthorizeView>

    </div>
</div>


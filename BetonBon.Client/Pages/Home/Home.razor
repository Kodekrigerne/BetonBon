@page "/"

@using BetonBon.Client.Auth
@using BetonBon.Client.Pages.Administration
@using BetonBon.Client.Pages.RegistrationMenu
@using BetonBon.Client.Pages.Users
@using BetonBon.Client.Shared.Components
@using BetonBon.Client.Shared.Icons
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager _navigation
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider AuthStateProvider

<div class="home-container">
    @* Header *@
    <div class="header">
        <div class="header-profile">
            <div class="avatar">HE</div>
            
            <div class="header-info">
                <h1>Holmsgaard Entreprenør</h1>
                <p>CVR: 1728451 NH</p>
            </div>
        </div>
        
        <div style="position: relative;">
            <button class="icon-btn" @onclick="@ToggleDropdown">
                <CogWheelIcon/>
            </button>
            @if (IsDropdownVisible)
            {
                <div name="dropdown" style="position: absolute; right: 0; top: 100%;">
                    <button @onclick="@Logout">Log ud</button>
                </div>
            }
        </div>
    </div>

    @* Content *@
    <div class="content">
        <div class="welcome">
            <h2>Velkommen tilbage</h2>
            <p>Hvad vil du registrere i dag?</p>
        </div>

        <ProjectsCard OpenProjects="OpenRegistrations" />

        <TimerCard />

        <AuthorizeView Roles="Admin">

            <Authorized>
                <AdminCard OpenAdmin="NavigateToAdministration" />
            </Authorized>

        </AuthorizeView>

    </div>
</div>

